# LUP AI Environment Configuration (Template)
# Copy this file to .env and fill real credentials locally. Never commit .env.

# Runtime
LUP_ENV=development
LUP_LOG_LEVEL=INFO
LUP_TIMEZONE=America/Bogota

# Privacy policy (fixed to masked_cloud before Cloud LLM calls)
LUP_PRIVACY_MODE=masked_cloud

# Local storage (OLTP state, TTL cache, session alias map)
LUP_SQLITE_PATH=./data/lup_ai_local.db
LUP_CACHE_TTL_SECONDS=3600

# Cloud LLM layer (Gemini 3.8)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60

# Snowflake Data Cloud
SNOWFLAKE_ACCOUNT=your_account_locator
SNOWFLAKE_USER=your_snowflake_user
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE_AGENT=LUP_AGENT_RO
SNOWFLAKE_ROLE_INGEST=LUP_INGEST_RW
SNOWFLAKE_WAREHOUSE=LUP_WH_XS
SNOWFLAKE_DATABASE=LUP_AI_DB
SNOWFLAKE_SCHEMA_SEMANTIC=SEMANTIC
SNOWFLAKE_STATEMENT_TIMEOUT_SECONDS=15

# API Server & Scheduler
LUP_API_HOST=127.0.0.1
LUP_API_PORT=8000
LUP_SCHEDULER_ENABLED=true
LUP_PROACTIVE_SCAN_INTERVAL_MINUTES=720
LUP_BATCH_FLUSH_INTERVAL_MINUTES=60
LUP_PROACTIVE_SCAN_LOOKBACK_DAYS=90
